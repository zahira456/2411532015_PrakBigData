    {
      "cell_type": "code",
      "source": [
        "for col in [\"category\", \"payment_method\", \"shipping_city\"]:\n",
        "    df[col] = df[col].astype(\"string\").str.strip().str.title()\n",
        "\n",
        "# \"Cod\" adalah singkatan: kembalikan ke huruf kapital penuh setelah Title Case\n",
        "df[\"payment_method\"] = df[\"payment_method\"].replace({\"Cod\": \"COD\"})"
      ],
      "metadata": {
        "id": "eFAMWyUyme7i"
      },
      "execution_count": 46,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def bersihkan_harga(x):\n",
        "    if pd.isna(x):\n",
        "        return np.nan\n",
        "\n",
        "    x = str(x).strip().replace(\"Rp\", \"\").replace(\".\", \"\").replace(\",\", \".\")\n",
        "\n",
        "    try:\n",
        "        return float(x)\n",
        "    except ValueError:\n",
        "        return np.nan\n",
        "\n",
        "df[\"price\"] = df[\"price\"].apply(bersihkan_harga)"
      ],
      "metadata": {
        "id": "eGAdXY-xmfmg"
      },
      "execution_count": 47,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def parse_tanggal(x):\n",
        "    for fmt in (\"%Y-%m-%d\", \"%d/%m/%Y\", \"%d-%m-%Y\"):\n",
        "        try:\n",
        "            return pd.to_datetime(x, format=fmt)\n",
        "        except ValueError:\n",
        "            continue\n",
        "    return pd.NaT\n",
        "\n",
        "df[\"transaction_date\"] = df[\"transaction_date\"].apply(parse_tanggal).dt.strftime(\"%Y-%m-%d\")"
      ],
      "metadata": {
